# ==============================================================================
# Dapodik Bridge Daemon Configuration
# ==============================================================================

# Port daemon HTTP (default: 4712)
BRIDGE_PORT=4712
BRIDGE_HOST=0.0.0.0

# API Key untuk autentikasi endpoint incoming (opsional; kosongkan jika tidak ingin proteksi API Key)
# Penggunaan: Authorization: Bearer <BRIDGE_API_KEY> atau ?api_key=<BRIDGE_API_KEY>
BRIDGE_API_KEY=

# Koneksi PostgreSQL Dapodik Lokal
# Bridge secara otomatis mencoba password default Dapodik jika DB_PASSWORD dikosongkan
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=dapodik_dasmen
DB_SSLMODE=disable

# Konfigurasi Sinkronisasi Otomatis / Push ke Server Web Sekolah (Cloud)
# Endpoint webhook pada web sekolah pusat yang menerima payload data dari operator
PUSH_TARGET_URL=https://sekolah.sch.id/api/dapodik/webhook
PUSH_SECRET_TOKEN=ganti-dengan-secret-token-web-sekolah-anda
SCHOOL_NPSN=20500000
